[
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "selling_step_1_detected",
      "catalogId": "https://snap-sell.devhack.dev/a2ui/v1.0/snap_sell_catalog.json",
      "sendDataModel": true,
      "components": [
        {
          "id": "root",
          "component": "Column",
          "justify": "start",
          "align": "stretch",
          "children": [
            "step_progress",
            "detected_card",
            "questions_card",
            "continue_btn"
          ]
        },
        {
          "id": "step_progress",
          "component": "StepProgress",
          "currentStep": 1,
          "totalSteps": 4,
          "stepLabels": [
            "Detected",
            "Follow-up",
            "Preview",
            "Published"
          ],
          "subtitle": "Review the detected vehicle and answer what the photo cannot show."
        },
        {
          "id": "detected_card",
          "component": "DetectedItemCard",
          "category": "car",
          "imageUrl": {
            "@path": "/detected/imageUrl"
          },
          "confidence": 0.94,
          "summary": {
            "@path": "/detected/summary"
          },
          "fields": [
            {
              "key": "brand",
              "label": "Brand",
              "value": {
                "@path": "/detected/brand"
              },
              "editable": true
            },
            {
              "key": "model",
              "label": "Model",
              "value": {
                "@path": "/detected/model"
              },
              "editable": true
            },
            {
              "key": "year",
              "label": "Year / Generation",
              "value": {
                "@path": "/detected/year"
              },
              "editable": true
            },
            {
              "key": "color",
              "label": "Color",
              "value": {
                "@path": "/detected/color"
              },
              "editable": true
            }
          ],
          "isEv": true
        },
        {
          "id": "questions_card",
          "component": "Card",
          "child": "questions_column"
        },
        {
          "id": "questions_column",
          "component": "Column",
          "justify": "start",
          "align": "stretch",
          "children": [
            "questions_heading",
            "mileageKm_field",
            "scan_odometer_btn",
            "batteryRangeKm_field",
            "batteryHealthPct_field",
            "warrantyActive_field",
            "hasDamage_field"
          ]
        },
        {
          "id": "questions_heading",
          "component": "Text",
          "variant": "body",
          "text": "### About your 2021 Mazda CX-30"
        },
        {
          "id": "mileageKm_field",
          "component": "TextField",
          "label": "Mileage (km)",
          "value": {
            "@path": "/details/mileageKm"
          },
          "variant": "number"
        },
        {
          "id": "scan_odometer_btn_label",
          "component": "Text",
          "text": "Or scan odometer photo"
        },
        {
          "id": "scan_odometer_btn",
          "component": "Button",
          "variant": "borderless",
          "child": "scan_odometer_btn_label",
          "action": {
            "event": {
              "name": "request_odometer_scan",
              "context": {
                "category": "car"
              }
            }
          }
        },
        {
          "id": "batteryRangeKm_field",
          "component": "TextField",
          "label": "Battery range (km)",
          "value": {
            "@path": "/details/batteryRangeKm"
          },
          "variant": "number"
        },
        {
          "id": "batteryHealthPct_field",
          "component": "Slider",
          "label": "Battery health (%)",
          "min": 50,
          "max": 100,
          "value": {
            "@path": "/details/batteryHealthPct"
          }
        },
        {
          "id": "warrantyActive_field",
          "component": "CheckBox",
          "label": "Factory warranty still active",
          "value": {
            "@path": "/details/warrantyActive"
          }
        },
        {
          "id": "hasDamage_field",
          "component": "CheckBox",
          "label": "Has visible damage or known issues",
          "value": {
            "@path": "/details/hasDamage"
          }
        },
        {
          "id": "continue_btn_label",
          "component": "Text",
          "text": "Continue"
        },
        {
          "id": "continue_btn",
          "component": "Button",
          "variant": "primary",
          "child": "continue_btn_label",
          "action": {
            "event": {
              "name": "submit_detected_details",
              "context": {
                "category": "car",
                "brand": {
                  "@path": "/detected/brand"
                },
                "model": {
                  "@path": "/detected/model"
                },
                "year": {
                  "@path": "/detected/year"
                },
                "color": {
                  "@path": "/detected/color"
                },
                "mileageKm": {
                  "@path": "/details/mileageKm"
                },
                "batteryRangeKm": {
                  "@path": "/details/batteryRangeKm"
                },
                "batteryHealthPct": {
                  "@path": "/details/batteryHealthPct"
                },
                "warrantyActive": {
                  "@path": "/details/warrantyActive"
                },
                "hasDamage": {
                  "@path": "/details/hasDamage"
                },
                "isEv": true
              }
            }
          }
        }
      ],
      "dataModel": {
        "detected": {
          "imageUrl": "http://10.0.2.2:8000/uploads/demo_item.jpg",
          "summary": "Clean SUV.",
          "brand": "Mazda",
          "model": "CX-30",
          "year": "2021",
          "color": "Soul Red"
        },
        "details": {
          "mileageKm": "",
          "batteryRangeKm": "",
          "batteryHealthPct": 90,
          "warrantyActive": false,
          "hasDamage": false
        }
      }
    }
  }
]
