[
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "selling_step_1_detected",
      "catalogId": "https://snap-sell.devhack.dev/a2ui/v1.0/snap_sell_catalog.json",
      "sendDataModel": true,
      "components": [
        {
          "id": "root",
          "component": "Column",
          "justify": "start",
          "align": "stretch",
          "children": [
            "step_progress",
            "notice_0",
            "detected_card",
            "questions_card",
            "continue_btn"
          ]
        },
        {
          "id": "step_progress",
          "component": "StepProgress",
          "currentStep": 1,
          "totalSteps": 4,
          "stepLabels": [
            "Detected",
            "Follow-up",
            "Preview",
            "Published"
          ],
          "subtitle": "Review the detected smartphone and answer what the photo cannot show."
        },
        {
          "id": "notice_0",
          "component": "Text",
          "variant": "body",
          "text": "⚠️ Jev sees possible damage in the photo. Tell buyers about it first."
        },
        {
          "id": "detected_card",
          "component": "DetectedItemCard",
          "category": "phone",
          "imageUrl": {
            "@path": "/detected/imageUrl"
          },
          "confidence": 0.96,
          "summary": {
            "@path": "/detected/summary"
          },
          "fields": [
            {
              "key": "brand",
              "label": "Brand",
              "value": {
                "@path": "/detected/brand"
              },
              "editable": true
            },
            {
              "key": "model",
              "label": "Model",
              "value": {
                "@path": "/detected/model"
              },
              "editable": true
            },
            {
              "key": "year",
              "label": "Year / Generation",
              "value": {
                "@path": "/detected/year"
              },
              "editable": true
            },
            {
              "key": "color",
              "label": "Color",
              "value": {
                "@path": "/detected/color"
              },
              "editable": true
            }
          ]
        },
        {
          "id": "questions_card",
          "component": "Card",
          "child": "questions_column"
        },
        {
          "id": "questions_column",
          "component": "Column",
          "justify": "start",
          "align": "stretch",
          "children": [
            "questions_heading",
            "hasDamage_field",
            "storageGb_field",
            "screenCondition_field",
            "biometricsWork_field",
            "batteryHealthPct_field"
          ]
        },
        {
          "id": "questions_heading",
          "component": "Text",
          "variant": "body",
          "text": "### About your 2021 Mazda CX-30"
        },
        {
          "id": "hasDamage_field",
          "component": "CheckBox",
          "label": "Has visible damage or known issues",
          "value": {
            "@path": "/details/hasDamage"
          }
        },
        {
          "id": "storageGb_field",
          "component": "ChoicePicker",
          "label": "Internal storage",
          "variant": "mutuallyExclusive",
          "displayStyle": "chips",
          "options": [
            {
              "label": "128 GB",
              "value": "128"
            },
            {
              "label": "256 GB",
              "value": "256"
            },
            {
              "label": "512 GB",
              "value": "512"
            },
            {
              "label": "1 TB",
              "value": "1024"
            }
          ],
          "value": {
            "@path": "/details/storageGb"
          }
        },
        {
          "id": "screenCondition_field",
          "component": "ChoicePicker",
          "label": "Screen condition",
          "variant": "mutuallyExclusive",
          "displayStyle": "chips",
          "options": [
            {
              "label": "Perfect",
              "value": "perfect"
            },
            {
              "label": "Light scratches",
              "value": "scratches"
            },
            {
              "label": "Cracked",
              "value": "cracked"
            }
          ],
          "value": {
            "@path": "/details/screenCondition"
          }
        },
        {
          "id": "biometricsWork_field",
          "component": "CheckBox",
          "label": "Face ID / fingerprint works",
          "value": {
            "@path": "/details/biometricsWork"
          }
        },
        {
          "id": "batteryHealthPct_field",
          "component": "Slider",
          "label": "Battery health (%)",
          "min": 50,
          "max": 100,
          "value": {
            "@path": "/details/batteryHealthPct"
          }
        },
        {
          "id": "continue_btn_label",
          "component": "Text",
          "text": "Continue"
        },
        {
          "id": "continue_btn",
          "component": "Button",
          "variant": "primary",
          "child": "continue_btn_label",
          "action": {
            "event": {
              "name": "submit_detected_details",
              "context": {
                "category": "phone",
                "brand": {
                  "@path": "/detected/brand"
                },
                "model": {
                  "@path": "/detected/model"
                },
                "year": {
                  "@path": "/detected/year"
                },
                "color": {
                  "@path": "/detected/color"
                },
                "hasDamage": {
                  "@path": "/details/hasDamage"
                },
                "storageGb": {
                  "@path": "/details/storageGb"
                },
                "screenCondition": {
                  "@path": "/details/screenCondition"
                },
                "biometricsWork": {
                  "@path": "/details/biometricsWork"
                },
                "batteryHealthPct": {
                  "@path": "/details/batteryHealthPct"
                }
              }
            }
          }
        }
      ],
      "dataModel": {
        "detected": {
          "imageUrl": "http://10.0.2.2:8000/uploads/demo_item.jpg",
          "summary": "Clean SUV.",
          "brand": "Mazda",
          "model": "CX-30",
          "year": "2021",
          "color": "Soul Red"
        },
        "details": {
          "hasDamage": true,
          "storageGb": [
            "128"
          ],
          "screenCondition": [
            "perfect"
          ],
          "biometricsWork": true,
          "batteryHealthPct": 90
        }
      }
    }
  }
]
